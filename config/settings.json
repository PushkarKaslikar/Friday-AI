{
  "app": {
    "name": "Friday AI Assistant",
    "version": "1.0.0",
    "environment": "development",
    "debug": true
  },
  "ui": {
    "theme": "dark",
    "start_minimized": false,
    "auto_start": false
  },
  "logging": {
    "level": "INFO",
    "log_to_console": true,
    "log_to_file": true,
    "max_file_size_mb": 10,
    "retention_days": 30
  },
  "llm": {
    "provider": "fake",
    "model_name": "FakeModel-v1",
    "model_path": "fake://model",
    "preload_model": false,
    "context_size": 4096,
    "temperature": 0.3,
    "max_tokens": 512
  },
  "orchestrator": {
    "enabled": true,
    "max_steps": 5,
    "allow_tools": true
  }
}
